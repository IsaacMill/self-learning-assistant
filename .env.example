# Provider can be: openai, openrouter, or ollama.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mi

# OpenRouter example:
# LLM_PROVIDER=openrouter
# LLM_API_KEY=<your-openrouter-api-key>
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# Ollama OpenAI-compatible example:
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Backward-compatible OpenAI-style variables are still supported:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

ASSISTANT_DB=data/assistant.sqlite3
ASSISTANT_CHROMA_PATH=data/chroma
ASSISTANT_DEBUG=false
